{
  "name": "@dartfx/n8n-nodes-qsv",
  "version": "0.26.0",
  "description": "n8n community node for datHere QSV ultra-fast tabular data wrangling, stats, and transformations (requires 'qsv' CLI on host)",
  "keywords": [
    "n8n-community-node-package",
    "n8n-nodes",
    "qsv",
    "csv",
    "data-wrangling",
    "tabular",
    "data-engineering",
    "dartfx"
  ],
  "license": "MIT",
  "author": {
    "name": "Data Artifex",
    "url": "https://github.com/DataArtifex"
  },
  "homepage": "https://github.com/DataArtifex/dartfx-n8n-nodes-qsv",
  "repository": {
    "type": "git",
    "url": "https://github.com/DataArtifex/dartfx-n8n-nodes-qsv.git"
  },
  "bugs": {
    "url": "https://github.com/DataArtifex/dartfx-n8n-nodes-qsv/issues"
  },
  "main": "index.js",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "generate:qsv": "tsx scripts/generate-qsv-nodes.ts",
    "sync:qsv": "tsx scripts/sync-qsv-release.ts --local --align-minor",
    "sync:qsv:upstream": "tsx scripts/sync-qsv-release.ts --align-minor",
    "sync:qsv:check": "tsx scripts/sync-qsv-release.ts --check-only",
    "release:staging": "tsx scripts/sync-qsv-release.ts --local --align-minor --staging --publish",
    "release:prod": "tsx scripts/sync-qsv-release.ts --local --align-minor --git-tag --push",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "lint": "eslint \"**/*.ts\"",
    "test": "jest --passWithNoTests",
    "docs:build": "sphinx-build -b html docs/source docs/build/html",
    "docs:serve": "sphinx-autobuild docs/source docs/build/html",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/Qsv/Qsv.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "gulp": "^5.0.0",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.78.1",
    "prettier": "^3.5.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "qsvVersion": "26.0.0"
}
